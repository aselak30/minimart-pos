<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.minimartpos.controller.admin.ProductManagementController"
            stylesheets="@../../css/main.css"
            styleClass="scene-bg">

        <!-- ══════════════════ SIDEBAR ══════════════════ -->
    <left>
        <VBox styleClass="sidebar" spacing="0" minWidth="220">
            <VBox styleClass="sidebar-logo" spacing="4">
                <Label text="🛒 MiniMart POS" styleClass="sidebar-logo-text"/>
                <Label text="Admin Console" style="-fx-text-fill:#5A6A7A; -fx-font-size:11px;"/>
            </VBox>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background:transparent; -fx-background-color:transparent; -fx-border-color:transparent;">
                <VBox spacing="2" style="-fx-padding:8 0;">
                    <Label text="MAIN" styleClass="sidebar-section-label"/>
                    <Button text="📊  Dashboard" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToDashboard"/>
                    <Button text="🖥  POS Terminal" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToPOS"/>
                    <Button text="👥  Users" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToUsers"/>
                    <Button text="📦  Products" styleClass="sidebar-nav-item active" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToProducts"/>
                    <Button text="🧑  Customers" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToCustomers"/>
                    <Button text="🏭  Suppliers" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToSuppliers"/>
                    <Label text="OPERATIONS" styleClass="sidebar-section-label"/>
                    <Button text="💰  Live Monitor" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToCashierMonitor"/>
                    <Button text="🧾  Bills / History" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToBills"/>
                    <Button text="📉  Stock" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToStock"/>
                    <Label text="REPORTS" styleClass="sidebar-section-label"/>
                    <Button text="📈  Reports" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToReports"/>
                    <Button text="🔍  Audit Log" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToAudit"/>
                    <Label text="SYSTEM" styleClass="sidebar-section-label"/>
                    <Button text="⚙  Settings" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToSettings"/>
                </VBox>
            </ScrollPane>
            <VBox style="-fx-padding:12 16; -fx-border-color:rgba(255,255,255,0.08); -fx-border-width:1 0 0 0;" spacing="4">
                <Label fx:id="sidebarUserLabel" text="Admin" style="-fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:12px;"/>
            </VBox>
        </VBox>
    </left>

    <!-- ══════════════════ MAIN AREA ══════════════════ -->
    <center>
        <VBox spacing="0">

            <!-- TOP BAR -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="10">
                <Label text="📦  Product Management" styleClass="h3"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="searchField" promptText="🔍 Search products…"
                           styleClass="search-field" prefWidth="220"
                           onKeyReleased="#onSearchChanged"/>
                <ComboBox fx:id="categoryFilter" prefWidth="140" promptText="All Categories"
                          onAction="#onCategoryFilterChanged"/>
                <ComboBox fx:id="statusFilter" prefWidth="110" promptText="Active"
                          onAction="#onStatusFilterChanged"/>
                <Button text="＋ Add Product" styleClass="btn-primary, button" onAction="#openAddProduct"/>
                <Button text="📋 Download Template" styleClass="btn-secondary, button" onAction="#downloadTemplate"/>
                <Button text="📥 Import Excel" styleClass="btn-secondary, button" onAction="#importExcel"/>
                <Button text="📤 Export Excel" styleClass="btn-secondary, button" onAction="#exportExcel"/>
                <Button text="← Back" styleClass="btn-secondary, button" onAction="#navigateToDashboard"/>
            </HBox>

            <!-- BODY -->
            <HBox VBox.vgrow="ALWAYS" spacing="0">

                <!-- ══ PRODUCT TABLE ══ -->
                <VBox HBox.hgrow="ALWAYS" style="-fx-padding:16;" spacing="10">

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label fx:id="productCountLabel" text="0 products"
                               styleClass="text-secondary" style="-fx-font-size:12px;"/>
                        <Label fx:id="lowStockBadge" text="⚠ Low stock"
                               styleClass="badge badge-warning"
                               visible="false" managed="false"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="🔄" styleClass="btn-icon" onAction="#refreshProducts"
                                style="-fx-font-size:14px;"/>
                    </HBox>

                    <TableView fx:id="productTable" VBox.vgrow="ALWAYS" editable="false">
                        <columns>
                            <TableColumn fx:id="colBarcode"   text="Barcode"    prefWidth="120" minWidth="100"/>
                            <TableColumn fx:id="colName"      text="Product"    prefWidth="180" minWidth="140"/>
                            <TableColumn fx:id="colCategory"  text="Category"   prefWidth="110" minWidth="90"/>
                            <TableColumn fx:id="colPrice"     text="Price"      prefWidth="90"  minWidth="75"
                                         style="-fx-alignment:CENTER_RIGHT;"/>
                            <TableColumn fx:id="colCost"      text="Cost"       prefWidth="90"  minWidth="75"
                                         style="-fx-alignment:CENTER_RIGHT;"/>
                            <TableColumn fx:id="colStock"     text="Stock"      prefWidth="70"  minWidth="60"
                                         style="-fx-alignment:CENTER;"/>
                            <TableColumn fx:id="colReorder"   text="Reorder"    prefWidth="70"  minWidth="60"
                                         style="-fx-alignment:CENTER;"/>
                            <TableColumn fx:id="colExpiry"    text="Expiry"     prefWidth="100" minWidth="85"/>
                            <TableColumn fx:id="colStatus"    text="Status"     prefWidth="75"  minWidth="65"
                                         style="-fx-alignment:CENTER;"/>
                            <TableColumn fx:id="colActions"   text="Actions"    prefWidth="100" minWidth="90"
                                         style="-fx-alignment:CENTER;"/>
                        </columns>
                        <placeholder>
                            <Label text="No products found" styleClass="text-secondary"/>
                        </placeholder>
                    </TableView>

                </VBox>

                <!-- ══ EDIT PANEL ══ -->
                <VBox fx:id="editPanel" prefWidth="430" minWidth="400"
                      style="-fx-background-color:white; -fx-border-color:-pos-border; -fx-border-width:0 0 0 1;"
                      visible="false" managed="false">

                    <HBox styleClass="card-header" alignment="CENTER_LEFT" spacing="8"
                          style="-fx-padding:10 14;">
                        <Label fx:id="editPanelTitle" text="Product Details"
                               style="-fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:14px;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="✖" styleClass="btn-icon" onAction="#closeEditPanel"
                                style="-fx-text-fill:rgba(255,255,255,0.8); -fx-font-size:14px;"/>
                    </HBox>

                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                style="-fx-background:transparent; -fx-background-color:transparent; -fx-border-color:transparent;">
                        <VBox spacing="14" style="-fx-padding:16;">

                            <!-- Identification -->
                            <VBox styleClass="card" spacing="10">
                                <Label text="IDENTIFICATION" styleClass="label-form"/>
                                <HBox spacing="10">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="BARCODE *" styleClass="label-form"/>
                                        <TextField fx:id="fieldBarcode" styleClass="text-field"
                                                   promptText="e.g. 4890008100309"/>
                                    </VBox>
                                    <VBox spacing="4">
                                        <Label text="" styleClass="label-form"/>
                                        <Button text="🔢 Generate" styleClass="btn-secondary, button"
                                                style="-fx-font-size:11px;" onAction="#generateBarcode"/>
                                    </VBox>
                                </HBox>
                                <VBox spacing="4">
                                    <Label text="PRODUCT NAME *" styleClass="label-form"/>
                                    <TextField fx:id="fieldName" styleClass="text-field"
                                               promptText="e.g. Coca Cola 330ml" maxWidth="Infinity"/>
                                </VBox>
                                <HBox spacing="10">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="BRAND" styleClass="label-form"/>
                                        <TextField fx:id="fieldBrand" styleClass="text-field" promptText="e.g. Coca-Cola"/>
                                    </VBox>
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="SIZE / WEIGHT" styleClass="label-form"/>
                                        <TextField fx:id="fieldSize" styleClass="text-field" promptText="e.g. 330ml"/>
                                    </VBox>
                                </HBox>
                                <HBox spacing="10">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="CATEGORY *" styleClass="label-form"/>
                                        <HBox spacing="6">
                                            <ComboBox fx:id="fieldCategory" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                                            <Button text="＋" styleClass="btn-secondary, button"
                                                    style="-fx-font-size:12px;" onAction="#addCategory">
                                                <tooltip><Tooltip text="Add new category"/></tooltip>
                                            </Button>
                                        </HBox>
                                    </VBox>
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="SUPPLIER" styleClass="label-form"/>
                                        <ComboBox fx:id="fieldSupplier" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <!-- Pricing -->
                            <VBox styleClass="card" spacing="10">
                                <Label text="PRICING" styleClass="label-form"/>
                                <HBox spacing="10">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="SELLING PRICE *" styleClass="label-form"/>
                                        <TextField fx:id="fieldPrice" styleClass="text-field"
                                                   promptText="0.00" onKeyReleased="#updateMarginPreview"/>
                                    </VBox>
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="COST PRICE *" styleClass="label-form"/>
                                        <TextField fx:id="fieldCost" styleClass="text-field"
                                                   promptText="0.00" onKeyReleased="#updateMarginPreview"/>
                                    </VBox>
                                </HBox>
                                <!-- Live margin preview -->
                                <HBox alignment="CENTER_LEFT" spacing="10"
                                      style="-fx-background-color:-pos-surface-alt; -fx-padding:8; -fx-background-radius:6;">
                                    <Label text="Margin:" styleClass="text-secondary" style="-fx-font-size:12px;"/>
                                    <Label fx:id="marginPreviewLabel" text="—"
                                           style="-fx-font-weight:bold; -fx-font-size:13px; -fx-text-fill:-pos-success;"/>
                                    <Label text="Profit:" styleClass="text-secondary" style="-fx-font-size:12px;"/>
                                    <Label fx:id="profitPreviewLabel" text="—"
                                           style="-fx-font-weight:bold; -fx-font-size:13px; -fx-text-fill:-pos-primary;"/>
                                </HBox>
                                <HBox spacing="10">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="TAX RATE (%)" styleClass="label-form"/>
                                        <TextField fx:id="fieldTax" styleClass="text-field" promptText="0.00"/>
                                    </VBox>
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="MAX DISCOUNT (%)" styleClass="label-form"/>
                                        <TextField fx:id="fieldMaxDiscount" styleClass="text-field" promptText="0"/>
                                    </VBox>
                                </HBox>
                                <CheckBox fx:id="fieldDiscountAllowed" text="Discount allowed on this product"
                                          selected="true"/>
                            </VBox>

                            <!-- Stock -->
                            <VBox styleClass="card" spacing="10">
                                <Label text="STOCK" styleClass="label-form"/>
                                <HBox spacing="10">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="CURRENT STOCK *" styleClass="label-form"/>
                                        <TextField fx:id="fieldStock" styleClass="text-field" promptText="0"/>
                                    </VBox>
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="REORDER LEVEL" styleClass="label-form"/>
                                        <TextField fx:id="fieldReorder" styleClass="text-field" promptText="5"/>
                                    </VBox>
                                </HBox>
                                <HBox spacing="10">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="EXPIRY DATE" styleClass="label-form"/>
                                        <DatePicker fx:id="fieldExpiry" maxWidth="Infinity"/>
                                    </VBox>
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="BATCH NUMBER" styleClass="label-form"/>
                                        <TextField fx:id="fieldBatch" styleClass="text-field" promptText="Optional"/>
                                    </VBox>
                                </HBox>
                                <VBox spacing="4">
                                    <Label text="SHELF LOCATION" styleClass="label-form"/>
                                    <TextField fx:id="fieldLocation" styleClass="text-field" promptText="e.g. Aisle 3, Shelf B"/>
                                </VBox>
                            </VBox>

                            <!-- Status -->
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <CheckBox fx:id="fieldActive" text="Product Active" selected="true"/>
                            </HBox>

                            <!-- Error label -->
                            <Label fx:id="formErrorLabel" text=""
                                   styleClass="badge badge-danger" wrapText="true"
                                   visible="false" managed="false"/>

                            <!-- Buttons -->
                            <HBox spacing="8">
                                <Button fx:id="deactivateBtn" text="🚫 Deactivate"
                                        styleClass="btn-danger, button"
                                        onAction="#deactivateProduct"/>
                                <Button text="📋 Price History"
                                        styleClass="btn-secondary, button"
                                        onAction="#showPriceHistory"/>
                                <Button text="📄 Duplicate"
                                        styleClass="btn-secondary, button"
                                        onAction="#duplicateProduct"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button text="Cancel" styleClass="btn-secondary, button"
                                        onAction="#closeEditPanel"/>
                                <Button fx:id="saveBtn" text="💾 Save Product"
                                        styleClass="btn-primary, button"
                                        onAction="#saveProduct"/>
                            </HBox>

                        </VBox>
                    </ScrollPane>
                </VBox>

            </HBox>
        </VBox>
    </center>

</BorderPane>
