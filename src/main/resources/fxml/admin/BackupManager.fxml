<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.minimartpos.controller.admin.BackupManagerController"
            stylesheets="@../../css/main.css" styleClass="scene-bg">    <!-- ══════════════════ SIDEBAR ══════════════════ -->
    <left>
        <VBox styleClass="sidebar" spacing="0" minWidth="220">
            <VBox styleClass="sidebar-logo" spacing="4">
                <Label fx:id="sidebarCompanyLabel" text="🛒 MiniMart POS" styleClass="sidebar-logo-text"/>
                <Label text="Admin Console" style="-fx-text-fill:#5A6A7A; -fx-font-size:11px;"/>
            </VBox>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background:transparent; -fx-background-color:transparent; -fx-border-color:transparent;">
                <VBox spacing="2" style="-fx-padding:8 0;">
                    <Label text="MAIN" styleClass="sidebar-section-label"/>
                    <Button text="📊  Dashboard" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToDashboard"/>
                    <Button text="🖥  POS Terminal" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToPOS"/>
                    <Button text="👥  Users" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToUsers"/>
                    <Button text="📦  Products" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToProducts"/>
                    <Button text="🧑  Customers" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToCustomers"/>
                    <Button text="🏭  Suppliers" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToSuppliers"/>
                    <Label text="OPERATIONS" styleClass="sidebar-section-label"/>
                    <Button text="💰  Live Monitor" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToCashierMonitor"/>
                    <Button text="🧾  Bills / History" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToBills"/>
                    <Button text="📉  Stock" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToStock"/>
                    <Label text="REPORTS" styleClass="sidebar-section-label"/>
                    <Button text="📈  Reports" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToReports"/>
                    <Button text="🔍  Audit Log" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToAudit"/>
                    <Label text="SYSTEM" styleClass="sidebar-section-label"/>
                    <Button text="⚙  Settings" styleClass="sidebar-nav-item active" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToSettings"/>
                </VBox>
            </ScrollPane>
            <VBox style="-fx-padding:12 16; -fx-border-color:rgba(255,255,255,0.08); -fx-border-width:1 0 0 0;" spacing="4">
                <Label fx:id="sidebarUserLabel" text="Admin" style="-fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:12px;"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="0">

            <!-- Top bar -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="12">
                <Label text="💾  Backup &amp; Restore" styleClass="h3"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="← Back" styleClass="btn-secondary, button"
                        onAction="#navigateToDashboard"/>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background:transparent; -fx-background-color:-pos-bg; -fx-border-color:transparent;">
                <VBox spacing="16" style="-fx-padding:20;" maxWidth="900">

                    <!-- ── Auto backup settings ─────────────────────────────── -->
                    <VBox styleClass="card" spacing="12">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="🕐  Automatic Daily Backup" styleClass="h4"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="schedulerStatusLabel" text="● Running"
                                   style="-fx-text-fill:-pos-success; -fx-font-weight:bold; -fx-font-size:12px;"/>
                        </HBox>

                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <CheckBox fx:id="autoBackupCheck" text="Enable automatic daily backup"
                                      onAction="#onAutoBackupToggled"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Backup time:" styleClass="label-form"/>
                            <TextField fx:id="backupTimeField" prefWidth="90"
                                       styleClass="text-field" promptText="02:00"/>
                            <Button text="💾 Save Schedule" styleClass="btn-secondary, button"
                                    onAction="#saveSchedule"/>
                        </HBox>

                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="BACKUP FOLDER" styleClass="label-form"/>
                                <HBox spacing="8">
                                    <TextField fx:id="backupPathField" styleClass="text-field"
                                               HBox.hgrow="ALWAYS" editable="false"/>
                                    <Button text="📂 Change" styleClass="btn-secondary, button"
                                            onAction="#changeBackupPath"/>
                                </HBox>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="KEEP FOR" styleClass="label-form"/>
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <TextField fx:id="keepDaysField" prefWidth="60"
                                               styleClass="text-field"/>
                                    <Label text="days" styleClass="text-secondary"/>
                                </HBox>
                            </VBox>
                        </HBox>

                        <HBox spacing="8">
                            <Label fx:id="nextBackupLabel" text="Next backup: —"
                                   styleClass="text-secondary" style="-fx-font-size:12px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lastBackupLabel" text="Last backup: —"
                                   styleClass="text-secondary" style="-fx-font-size:12px;"/>
                        </HBox>
                    </VBox>

                    <!-- ── Manual backup ─────────────────────────────────────── -->
                    <VBox styleClass="card" spacing="12">
                        <Label text="📥  Manual Backup" styleClass="h4"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="💾 Back Up Now" styleClass="btn-primary, button"
                                    style="-fx-font-size:13px; -fx-min-height:42px; -fx-min-width:160px;"
                                    onAction="#backupNow"/>
                            <Label fx:id="backupStatusLabel" text=""
                                   style="-fx-font-size:13px;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <ProgressBar fx:id="backupProgress" prefWidth="200"
                                         visible="false" managed="false"/>
                        </HBox>
                    </VBox>

                    <!-- ── Backup history ─────────────────────────────────────── -->
                    <VBox styleClass="card" spacing="10">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="📋  Backup History" styleClass="h4"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="backupCountLabel" text="0 backups"
                                   styleClass="text-secondary" style="-fx-font-size:12px;"/>
                            <Button text="🔄" styleClass="btn-icon" onAction="#refreshHistory"
                                    style="-fx-font-size:14px;"/>
                        </HBox>

                        <TableView fx:id="historyTable" prefHeight="240"
                                   style="-fx-border-color:-pos-border;">
                            <columns>
                                <TableColumn fx:id="colBackupName" text="File Name"      prefWidth="280"/>
                                <TableColumn fx:id="colBackupDate" text="Date / Time"    prefWidth="150"/>
                                <TableColumn fx:id="colBackupSize" text="Size"           prefWidth="90"
                                             style="-fx-alignment:CENTER_RIGHT;"/>
                                <TableColumn fx:id="colBackupType" text="Type"           prefWidth="80"
                                             style="-fx-alignment:CENTER;"/>
                                <TableColumn fx:id="colBackupActions" text="Actions"     prefWidth="160"
                                             style="-fx-alignment:CENTER;"/>
                            </columns>
                            <placeholder>
                                <Label text="No backup files found" styleClass="text-secondary"/>
                            </placeholder>
                        </TableView>
                    </VBox>

                    <!-- ── Restore ────────────────────────────────────────────── -->
                    <VBox styleClass="card" spacing="10"
                          style="-fx-border-color:-pos-danger; -fx-border-width:1; -fx-border-radius:8;">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="⚠  Restore Database" styleClass="h4"
                                   style="-fx-text-fill:-pos-danger;"/>
                        </HBox>
                        <Label text="WARNING: Restoring will overwrite ALL current data. This cannot be undone."
                               style="-fx-text-fill:-pos-danger; -fx-font-size:12px;" wrapText="true"/>
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button text="📂 Choose Backup File &amp; Restore"
                                    styleClass="btn-danger, button"
                                    onAction="#restoreFromFile"/>
                            <Label fx:id="restoreStatusLabel" text=""
                                   style="-fx-font-size:12px;" wrapText="true"/>
                        </HBox>
                    </VBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
