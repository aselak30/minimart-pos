<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.minimartpos.controller.admin.CashierMonitorController"
            stylesheets="@../../css/main.css" styleClass="scene-bg">    <!-- ══════════════════ SIDEBAR ══════════════════ -->
    <left>
        <VBox styleClass="sidebar" spacing="0" minWidth="220">
            <VBox styleClass="sidebar-logo" spacing="4">
                <Label text="🛒 MiniMart POS" styleClass="sidebar-logo-text"/>
                <Label text="Admin Console" style="-fx-text-fill:#5A6A7A; -fx-font-size:11px;"/>
            </VBox>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background:transparent; -fx-background-color:transparent; -fx-border-color:transparent;">
                <VBox spacing="2" style="-fx-padding:8 0;">
                    <Label text="MAIN" styleClass="sidebar-section-label"/>
                    <Button text="📊  Dashboard" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToDashboard"/>
                    <Button text="🖥  POS Terminal" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToPOS"/>
                    <Button text="👥  Users" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToUsers"/>
                    <Button text="📦  Products" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToProducts"/>
                    <Button text="🧑  Customers" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToCustomers"/>
                    <Button text="🏭  Suppliers" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToSuppliers"/>
                    <Label text="OPERATIONS" styleClass="sidebar-section-label"/>
                    <Button text="💰  Live Monitor" styleClass="sidebar-nav-item active" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToCashierMonitor"/>
                    <Button text="🧾  Bills / History" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToBills"/>
                    <Button text="📉  Stock" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToStock"/>
                    <Label text="REPORTS" styleClass="sidebar-section-label"/>
                    <Button text="📈  Reports" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToReports"/>
                    <Button text="🔍  Audit Log" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToAudit"/>
                    <Label text="SYSTEM" styleClass="sidebar-section-label"/>
                    <Button text="⚙  Settings" styleClass="sidebar-nav-item" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#navigateToSettings"/>
                </VBox>
            </ScrollPane>
            <VBox style="-fx-padding:12 16; -fx-border-color:rgba(255,255,255,0.08); -fx-border-width:1 0 0 0;" spacing="4">
                <Label fx:id="sidebarUserLabel" text="Admin" style="-fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:12px;"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="0">
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="12">
                <Label text="👁  Live Cashier Monitor" styleClass="h3"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lastRefreshLabel" text="Last refresh: —"
                       styleClass="text-secondary" style="-fx-font-size:11px;"/>
                <Label fx:id="autoRefreshLabel" text="● Auto-refresh ON"
                       style="-fx-text-fill:-pos-success; -fx-font-size:11px;"/>
                <Button fx:id="pauseBtn" text="⏸ Pause" styleClass="btn-secondary, button"
                        onAction="#toggleAutoRefresh"/>
                <Button text="🔄 Refresh Now" styleClass="btn-primary, button"
                        onAction="#refreshNow"/>
                <Button text="← Back" styleClass="btn-secondary, button"
                        onAction="#navigateToDashboard"/>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background:transparent; -fx-background-color:-pos-bg; -fx-border-color:transparent;">
                <VBox spacing="16" style="-fx-padding:20;">

                    <!-- Alert banner — visible only when cashiers exceed limit -->
                    <HBox fx:id="alertBanner" styleClass="alert-banner"
                          visible="false" managed="false"
                          style="-fx-background-color:-pos-danger; -fx-background-radius:8; -fx-padding:10 16; -fx-alignment:CENTER_LEFT;"
                          spacing="12">
                        <Label fx:id="alertBannerText" text=""
                               style="-fx-text-fill:white; -fx-font-weight:bold; -fx-font-size:13px;"
                               HBox.hgrow="ALWAYS" wrapText="true"/>
                        <Button text="✖ Dismiss" styleClass="btn-secondary, button"
                                onAction="#dismissAlert"/>
                    </HBox>

                    <HBox spacing="12">
                        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="4">
                            <Label text="ACTIVE CASHIERS" styleClass="kpi-label"/>
                            <Label fx:id="activeCashiersKpi" text="0" styleClass="kpi-value"/>
                        </VBox>
                        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="4">
                            <Label text="TOTAL CASH TODAY" styleClass="kpi-label"/>
                            <Label fx:id="totalCashKpi" text="Rs. 0.00" styleClass="kpi-value"
                                   style="-fx-text-fill:-pos-success;"/>
                        </VBox>
                        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="4">
                            <Label text="TOTAL SALES TODAY" styleClass="kpi-label"/>
                            <Label fx:id="totalSalesKpi" text="Rs. 0.00" styleClass="kpi-value"/>
                        </VBox>
                        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="4">
                            <Label text="BILLS TODAY" styleClass="kpi-label"/>
                            <Label fx:id="totalBillsKpi" text="0" styleClass="kpi-value"/>
                        </VBox>
                        <VBox styleClass="kpi-card" HBox.hgrow="ALWAYS" spacing="4">
                            <Label text="LIMIT ALERTS" styleClass="kpi-label"/>
                            <Label fx:id="limitAlertsKpi" text="0"
                                   style="-fx-font-size:28px; -fx-font-weight:bold; -fx-text-fill:-pos-danger;"/>
                        </VBox>
                    </HBox>

                    <VBox styleClass="card" spacing="12">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="CASHIER COLLECTION STATUS" styleClass="h4"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Click any cashier card to edit their cash limit"
                                   styleClass="text-secondary" style="-fx-font-size:11px;"/>
                        </HBox>
                        <FlowPane fx:id="cashierCardsPane" hgap="12" vgap="12"/>
                        <Label fx:id="noCashiersLabel" text="No active cashiers at this time."
                               styleClass="text-secondary"
                               style="-fx-font-size:13px; -fx-padding:20 0;"/>
                    </VBox>

                    <VBox styleClass="card" spacing="10">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="RECENT TRANSACTIONS — All Cashiers" styleClass="h4"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="recentCountLabel" text="" styleClass="text-secondary"
                                   style="-fx-font-size:12px;"/>
                        </HBox>
                        <TableView fx:id="recentBillsTable" prefHeight="220"
                                   style="-fx-border-color:-pos-border;">
                            <columns>
                                <TableColumn fx:id="rbColTime"     text="Time"     prefWidth="80"/>
                                <TableColumn fx:id="rbColBill"     text="Bill #"   prefWidth="160"/>
                                <TableColumn fx:id="rbColCashier"  text="Cashier"  prefWidth="150"/>
                                <TableColumn fx:id="rbColCustomer" text="Customer" prefWidth="130"/>
                                <TableColumn fx:id="rbColAmount"   text="Amount"   prefWidth="110"
                                             style="-fx-alignment:CENTER_RIGHT;"/>
                                <TableColumn fx:id="rbColPayment"  text="Payment"  prefWidth="100"
                                             style="-fx-alignment:CENTER;"/>
                            </columns>
                            <placeholder>
                                <Label text="No transactions yet today" styleClass="text-secondary"/>
                            </placeholder>
                        </TableView>
                    </VBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
